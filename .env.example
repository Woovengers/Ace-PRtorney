GITHUB_TOKENS=ghp_xxx,ghp_yyy

# GitHub App user authorization for user-attributed PR review comments.
# Configure the GitHub App with:
# - Callback URL: http://localhost:3000/api/auth/github/callback for local Vercel dev
# - Repository permissions: Contents read, Pull requests read/write, Metadata read
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_COOKIE_SECRET=replace-with-a-long-random-string

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_ANON_KEY=eyJxxx
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
# Optional for IPv4-only environments. Prefer Supabase Dashboard > Connect > Session pooler.
DATABASE_POOLER_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional. Only use this in trusted server-side scripts/API routes.
# Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
